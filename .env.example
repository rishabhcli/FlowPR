# Core app
NEXT_PUBLIC_APP_URL=http://localhost:3000
FLOWPR_AGENT_NAME=flowpr-autonomous-frontend-qa
FLOWPR_AGENT_VERSION=0.1.0
# Explicit local-only dashboard mode. Keep the session flag false or unset in production.
FLOWPR_DATA_MODE=
FLOWPR_ALLOW_LOCAL_SESSION=false
# Optional absolute path for the local durable store (useful for isolated workspaces/tests).
FLOWPR_LOCAL_STORE_DIR=
# Required in production to sign the OAuth session cookie.
FLOWPR_SESSION_SECRET=

# TinyFish - primary live browser engine
TINYFISH_API_KEY=
# Optional. Leave blank to use the SDK default TinyFish Agent API host.
TINYFISH_API_BASE_URL=
# Optional local/deployed Chromium binary override for Playwright evidence.
FLOWPR_PLAYWRIGHT_EXECUTABLE_PATH=

# Redis
REDIS_URL=redis://localhost:6379

# InsForge
INSFORGE_API_URL=
INSFORGE_ANON_KEY=
# Legacy fallback supported by local tooling:
INSFORGE_API_KEY=
INSFORGE_ARTIFACT_BUCKET=flowpr-artifacts

# WunderGraph / Cosmo
WUNDERGRAPH_API_URL=
WUNDERGRAPH_API_KEY=
WUNDERGRAPH_MCP_URL=

# Guild.ai
GUILD_AI_API_KEY=
GUILD_AI_WORKSPACE=
GUILD_AI_AGENT_ID=flowpr-autonomous-frontend-qa
GUILD_GITHUB_APP_INSTALLED=false

# Senso
SENSO_API_KEY=
SENSO_API_BASE_URL=https://apiv2.senso.ai/api/v1
SENSO_KB_ID=

# Shipables
SHIPABLES_API_KEY=

# Akash
AKASH_API_KEY=
AKASH_MNEMONIC=
AKASH_PRIVATE_KEY_HEX=
AKASH_ACCOUNT_ADDRESS=
AKASH_NETWORK=mainnet

# GitHub
# Preferred: GitHub App installation credentials for autonomous PR branches.
# GITHUB_APP_PRIVATE_KEY may use escaped newlines, or set GITHUB_APP_PRIVATE_KEY_BASE64.
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Anthropic — drives the autonomous code patcher (Claude Sonnet).
# When unset, FlowPR only uses the seeded cookie-banner patch for the local
# FlowPR demo repository; arbitrary repositories stop for human review.
ANTHROPIC_API_KEY=
